{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    // For nodejs:
    "types": ["node"],
     // Make sure 'dom' and 'esnext' are included in the 'lib' array
    "lib": ["dom", "dom.iterable", "esnext"], 

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": false, // start false for migration process only
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    // Important for incremental migration
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["src", "src/global.d.ts", "vite-env.d.ts", "env"],
  "exclude": ["node_modules", "dist"]
}
